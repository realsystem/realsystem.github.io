---
import BaseLayout from '../layouts/BaseLayout.astro';

const youtubeUrl = 'https://www.youtube.com/@realsystemrobot';

// Replace these with your actual video IDs from YouTube
const featuredVideos = [
  { id: 'ptKyAY0qIQM', title: 'Long travel suspension from Marlin Crawler | RCLT HD installation' },
  { id: 'dRX7S2jRmjs', title: 'Building truck camper -- Ep. 1: materials and removing the bed' },
  { id: 'Dl5wt6yTeDY', title: 'Escalante National Monument: Driving the Hole-in-the-Rock Road' },
];
---

<BaseLayout title="Home | Overlanding Project Lab">
  <!-- Hero Section -->
  <section class="min-h-screen flex flex-col justify-center items-center text-center px-6 bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900">
    <h1 class="block text-5xl md:text-7xl font-bold
         text-transparent bg-clip-text
         bg-gradient-to-r from-accent via-accent-hover to-success
         pb-[0.15em] mb-6">
      Overlanding. Builds. Travel.
    </h1>
    <p class="mt-6 text-lg md:text-xl text-text-secondary max-w-2xl leading-relaxed">
      Custom modifications, real expeditions, and off-road adventures. Follow along for authentic builds and travel stories from the trail.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-4">
      <a 
        href={youtubeUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-8 py-4 bg-accent hover:bg-accent-hover rounded-lg font-semibold text-gray-900 transition-all transform hover:scale-105 shadow-lg"
      >
        Visit YouTube Channel
      </a>
      <a 
        href="#videos" 
        class="px-8 py-4 bg-bg-tertiary hover:bg-bg-hover rounded-lg font-semibold text-text-primary transition-all"
      >
        Watch Videos
      </a>
    </div>
  </section>

  <!-- Featured Videos Section -->
  <section id="videos" class="py-20 px-6 max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4 text-center">
      Featured Videos
    </h2>
    <p class="text-text-muted text-center mb-12 max-w-2xl mx-auto">
      Check out our latest builds, adventures, and gear reviews
    </p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredVideos.map(video => (
        <div class="group">
          <iframe 
            class="w-full h-56 md:h-64 rounded-lg shadow-lg transition-transform group-hover:scale-105" 
            src={`https://www.youtube.com/embed/${video.id}`}
            title={video.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
          <p class="mt-3 text-text-secondary text-sm font-medium">{video.title}</p>
        </div>
      ))}
    </div>
    <div class="text-center mt-12">
      <a 
        href={youtubeUrl} 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-6 py-3 bg-bg-tertiary hover:bg-bg-hover text-text-primary rounded-lg transition-colors"
      >
        View All Videos →
      </a>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-20 px-6 bg-gradient-to-r from-accent to-success">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Ready to Start Your Journey?
      </h2>
      <p class="text-gray-900 text-lg mb-8 opacity-90">
        Subscribe to the channel for weekly content on overlanding builds and adventures
      </p>
      <a 
        href={youtubeUrl} 
        target="_blank"
        rel="noopener noreferrer" 
        class="inline-block px-8 py-4 bg-bg-primary hover:bg-bg-secondary text-white rounded-lg font-semibold transition-all transform hover:scale-105 shadow-xl"
      >
        Subscribe Now
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes gradient-x {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  
  .animate-gradient-x {
    background-size: 200% 200%;
    animation: gradient-x 3s ease infinite;
  }
</style>
