---
import BaseLayout from '../layouts/BaseLayout.astro';

const youtubeUrl = 'https://www.youtube.com/@realsystemrobot';

const stats = [
  { number: '50+', label: 'Custom Modifications' },
  { number: '10K+', label: 'Miles Traveled' },
  { number: '100+', label: 'Videos Created' },
];
---

<BaseLayout title="About | Overlanding Project Lab">
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] flex items-center justify-center px-6 bg-gradient-to-b from-gray-900 to-gray-800">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-accent to-success mb-6">
        About the Channel
      </h1>
      <p class="text-xl md:text-2xl text-text-secondary leading-relaxed">
        Building rigs. Exploring trails. Sharing the journey.
      </p>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-16 px-6 bg-bg-secondary">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-3 gap-8">
        {stats.map(stat => (
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-bold text-accent mb-2">
              {stat.number}
            </div>
            <div class="text-text-secondary text-lg">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Main Story Section -->
  <section class="py-20 px-6 max-w-4xl mx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
          My Story
        </h2>
        <p class="text-text-secondary leading-relaxed mb-4">
          I'm a passionate overlanding enthusiast and truck builder who believes that the best adventures happen off the beaten path. What started as weekend camping trips evolved into a full-blown passion for vehicle modification and remote exploration.
        </p>
        <p class="text-text-secondary leading-relaxed mb-4">
          Every modification I make serves a purpose—whether it's adding clearance for rocky trails, mounting recovery gear for remote situations, or creating storage solutions for extended trips. I document everything because I believe in sharing knowledge and helping others build capable rigs.
        </p>
        <p class="text-text-secondary leading-relaxed">
          My goal is to inspire others to get out there, whether that's a quick weekend trip or a multi-week expedition. The outdoors is for everyone, and with the right preparation, anyone can explore confidently.
        </p>
      </div>
      <div>
        <img
          src="/assets/images/PXL_20250830_215115254.jpg"
          alt="Overlanding vehicle on the trail"
          class="w-full rounded-lg shadow-2xl"
        />
      </div>
    </div>
  </section>

  <!-- Gear & Setup Section -->
  <section class="py-20 px-6 bg-bg-secondary">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-8 text-center">
        My Setup
      </h2>
      <div class="bg-bg-primary rounded-lg p-8 shadow-xl">
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-xl font-bold text-accent mb-4">The Rig</h3>
            <ul class="space-y-3 text-text-secondary">
              <li class="flex items-start">
                <span class="text-accent mr-2">•</span>
                <span>Custom suspension with increased ground clearance</span>
              </li>
              <li class="flex items-start">
                <span class="text-accent mr-2">•</span>
                <span>Heavy-duty skid plates and rock sliders</span>
              </li>
              <li class="flex items-start">
                <span class="text-accent mr-2">•</span>
                <span>Expedition-grade bumpers with recovery points</span>
              </li>
              <li class="flex items-start">
                <span class="text-accent mr-2">•</span>
                <span>Rooftop tent and storage system</span>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="text-xl font-bold text-accent mb-4">Content Creation</h3>
            <ul class="space-y-3 text-text-secondary">
              <li class="flex items-start">
                <span class="text-accent mr-2">•</span>
                <span>Multiple camera angles for detailed build videos</span>
              </li>
              <li class="flex items-start">
                <span class="text-accent mr-2">•</span>
                <span>Action cameras for trail footage</span>
              </li>
              <li class="flex items-start">
                <span class="text-accent mr-2">•</span>
                <span>Drone for aerial adventure shots</span>
              </li>
              <li class="flex items-start">
                <span class="text-accent mr-2">•</span>
                <span>Professional editing to share the full story</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-20 px-6 max-w-4xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
      Let's Connect
    </h2>
    <p class="text-text-secondary text-lg mb-8 max-w-2xl mx-auto">
      Follow my latest adventures, builds, and gear reviews on YouTube. New videos every week covering everything from bolt-on mods to multi-day expeditions.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a 
        href={youtubeUrl} 
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-4 bg-accent hover:bg-accent-hover rounded-lg font-semibold text-gray-900 transition-all transform hover:scale-105 shadow-lg"
      >
        Subscribe on YouTube
      </a>
      <a 
        href="/#videos" 
        class="px-8 py-4 bg-bg-tertiary hover:bg-bg-hover rounded-lg font-semibold text-text-primary transition-all"
      >
        Watch Recent Videos
      </a>
    </div>
  </section>
</BaseLayout>
